# Environment template. The stack is started with `docker compose up` (see README.md).
#
# Each variable is described here: its purpose, unit and range. How the values are read and
# checked is in docs/architecture/config.md.
#
# This is a working set for local development, not a copy of the defaults of the code:
# - The superuser pair, the time zone and the date style are not read by the application
#   ("Superuser settings" below says who reads them).
# - DATABASE_PORT, DATABASE_NAME and DATABASE_USER_PASSWORD are read by the application but differ
#   from its defaults on purpose, because they serve the local stack.
# - Everything else equals the default from ConfigValuesBuilder, and for the two CONFIG_FILE_
#   variables from ApplicationContext.createStorage(). Otherwise the template silently starts
#   dictating other behaviour.

# The mode of the application: production | development | testing.
# In production the logs are written by PinoLogger (JSON), in the other modes by ConsoleLogger.
# NODE_ENV is also set in the image (Dockerfile), so a start that bypasses Compose takes its value
# from there. The former ENVIRONMENT is no longer read.
NODE_ENV=development

### Postgres START ###
## Host settings
DATABASE_HOST=localhost
# The port Postgres is published on to the host, from 1 to 65535. Inside the compose network the
# application always goes to pgsql:5432: docker-compose.app.yml sets it and overrides the values
# from here.
DATABASE_PORT=54320

## Superuser settings for Docker
# Who reads the superuser pair, DATABASE_TIMEZONE and DATABASE_DATE_STYLE:
# - docker-compose.db.yml: all four;
# - the first-run script docker/pgsql/docker-entrypoint-initdb.d/init-user-db.sh:
#   DATABASE_SUPERUSER_NAME, and with it DATABASE_USER_NAME, DATABASE_USER_PASSWORD and
#   DATABASE_NAME. It runs only on an empty data directory, so renaming any of them breaks not the
#   current database but the next one;
# - the test hook test/database-hook.ts: the superuser pair. It creates the database of a run as
#   the superuser from the environment of the app container, so renaming either of the pair breaks
#   the very next `make test` as well.
# see https://github.com/docker-library/docs/tree/master/postgres#postgres_user
DATABASE_SUPERUSER_NAME=root
# see https://github.com/docker-library/docs/tree/master/postgres#postgres_password
DATABASE_SUPERUSER_PASSWORD=root

## Settings of the ordinary user and of the database
# The name of the database that will be created for the application
DATABASE_NAME=docker_db
# The name of the user that will be created for the application
DATABASE_USER_NAME=docker
# The password of the user the application will connect with
DATABASE_USER_PASSWORD=docker
# The time zone of the database
DATABASE_TIMEZONE=Asia/Tashkent
# The date style of the database
DATABASE_DATE_STYLE="iso, dmy"
# The maximum number of connections in the pool, from 1. LISTEN takes one more outside it
# (docs/architecture/storage.md).
DATABASE_CONNECTION_LIMIT=15
# The two pool deadlines below are in seconds, from 0 to 2147483: postgres.js multiplies them by
# 1000 for a timer, and 0 switches the timer off.
# The maximum idle time of a connection
DATABASE_CONNECTION_IDLE_TIMEOUT=10
# The maximum lifetime of a connection. It is the upper bound of a life, so it has to be greater
# than the idle time: otherwise a connection never lives to the end of an idle period.
DATABASE_CONNECTION_MAX_LIFETIME=600

# DATABASE_URL is deliberately not here: it is read only by node-pg-migrate and is assembled in
# docker-compose.app.yml, where ${...} substitution really works (in an env_file Compose passes
# the values as they are, without expansion).
### Postgres END ###


### The hot configuration file
# The path of the file the application watches: on every edit of it the configuration is rebuilt,
# and the code subscribed to a path that changed receives the new value
# (docs/architecture/config.md, "Watching the file"). Blank means <application root>/.runtime.env,
# which inside the container is /app/.runtime.env, where the file of the same name from the host
# is mounted (docker-compose.app.yml). The values of the file yield to the environment variables,
# including the ones set here: only what the environment does not hold or declares blank can be
# changed on the fly.
CONFIG_FILE_PATH=
# How often that file is polled, ms, from 100 to 2147483647. A value that is not allowed fails the
# start.
CONFIG_FILE_WATCH_INTERVAL=2000


## Logger
# The minimum logging level: it and everything more serious is written. The level names are the
# keys of Level in src/platform/logger/logger.types.ts. The default depends on the mode and is in
# docs/architecture/logging.md.
# The former LOGGER_LEVELS with a list of levels is no longer read. The former LOGGER_DEFAULT is
# no longer read either: the logging backend is chosen by NODE_ENV.
LOGGER_LEVEL=""

### Bot
# The token from @BotFather. Required: a blank one fails the start, and the Bot constructor checks
# it once more.
BOT_TOKEN=


### Graceful shutdown
# The deadlines are in ms, at most 2147483647. How they relate: docs/architecture/invariants.md,
# "Shutdown deadlines".
#
# The overall deadline for stopping the application as a whole: shutting the bot down, stopping
# the outbox and closing the Postgres pool. Whatever did not make it stays unfinished, and the
# process exits.
# - It has to be greater than the sum of the bot deadline below and OUTBOX_STOP_TIMEOUT, which are
#   spent one after another. Otherwise the application does not start and fails with
#   InvalidConfigError.
# - The check goes no further: the own deadlines of the dependencies are not summed up (sql.end()
#   has 5 seconds of its own when the pool is closed), so the value is taken with a margin.
# - It has to be less than the stop grace period of the container (docker-compose.app.yml),
#   otherwise the container is killed before the deadline.
# The former BOT_SHUTDOWN_TIMEOUT is no longer read: the deadline is now about stopping the whole
# application rather than the bot alone.
GRACEFUL_SHUTDOWN_TIMEOUT=15000
# How long to wait for the long-polling runner of the bot to stop, from 0.
BOT_GRACEFUL_SHUTDOWN_TIMEOUT=3000


### Limits
# The limits of the outbox; what they do is in docs/architecture/outbox.md, "Limits". The intervals
# are in ms. Every value is from 1 (docs/architecture/invariants.md).
# Common
LIMIT_COMMON_NUMBER=30
LIMIT_COMMON_INTERVAL=1000
# Private
LIMIT_PRIVATE_NUMBER=3
LIMIT_PRIVATE_INTERVAL=1000
# Group
LIMIT_GROUP_NUMBER=20
LIMIT_GROUP_INTERVAL=60000

### Outbox
# The delay before the retry of a message after a transient failure, and of an inbox update as well
# (docs/architecture/inbox.md, "Outcomes"), and the pause of the polling source of the inbox after
# a failure (the same file, "The polling source"); what it does is in docs/architecture/outbox.md. The
# first step and its cap are in ms, from 1 to 2147483647, the cap not below the first step. Each
# further counted attempt multiplies the step by the multiplier, an integer from 1; 1 keeps the step
# constant.
OUTBOX_RETRY_FIRST_DELAY=1000
OUTBOX_RETRY_MAX_DELAY=60000
OUTBOX_RETRY_DELAY_MULTIPLIER=2
# How long a caller waits for the outcome of its message before the wait fails, and how often the
# messages still waited for are looked up in case their notification was lost; ms, from 1 to
# 2147483647. What they do is in docs/architecture/outbox.md, "Waiting for the result".
OUTBOX_RESULT_TIMEOUT=60000
OUTBOX_RESULT_POLL_INTERVAL=1000
# How many attempts a message has, from 1; what counts is in docs/architecture/outbox.md,
# "Outcomes". At the defaults of the three OUTBOX_RETRY_ variables and this one, with no 429 on the
# way, the 10 attempts ride out some 2 to 4 minutes of an outage: from half the sum of the steps of
# their nine retries to the whole of it, the last three retries at the cap.
OUTBOX_MAX_ATTEMPTS=10
# How long a pulled chat stays with the node that pulled it; ms, from 1 to 2147483647. It must
# outlast the send of its message (docs/architecture/invariants.md, "The outbox"): the start fails
# on a lease not above OUTBOX_API_TIMEOUT. It is also how long the chats of a node that died wait
# before another node takes them back, so it stays a little above the call timeout.
OUTBOX_LEASE_DURATION=90000
# How long the outbox waits for one Bot API call before it fails with an HttpError; ms, from 1 to
# 2147483647. grammY waits 500 s by default. The time covers the upload of the files of the call
# too: a large document on a slow uplink fails on every attempt until its chat is blocked, so such
# a setup needs a longer value.
OUTBOX_API_TIMEOUT=60000
# How long a done and a skipped message are kept after their end before the cleanup deletes them;
# ms, from 1 to 9007199254740991. Both must outlast OUTBOX_RESULT_TIMEOUT and OUTBOX_LEASE_DURATION
# (docs/architecture/invariants.md, "The outbox"). A failed message is never deleted automatically.
# The defaults are 7 and 30 days. What the cleanup does is in docs/architecture/outbox.md, "Cleanup".
OUTBOX_DONE_RETENTION=604800000
OUTBOX_SKIPPED_RETENTION=2592000000
# The most messages, or chats, one call of the cleanup deletes; from 1 to 9007199254740991.
OUTBOX_CLEANUP_BATCH_SIZE=1000
# How many messages the runner of a node sends at once, from 1. Each completes its message on
# a connection of the pool, and the pull and the four maintenance tasks take five more, so the
# start fails unless OUTBOX_CONCURRENCY + 5 is below DATABASE_CONNECTION_LIMIT.
OUTBOX_CONCURRENCY=5
# How long the stop of the runner waits for the calls in flight before it aborts them and
# hands their messages to the other nodes; ms, from 0 to 2147483647, 0 aborts them at once.
OUTBOX_STOP_TIMEOUT=5000
# How often a node takes back the messages of the expired leases, how often it runs the cleanup,
# and how often it writes the status line of the outbox to the info log; ms, from 1 to 2147483647.
# What they do is in docs/architecture/outbox.md, "Maintenance".
OUTBOX_MAINTENANCE_LEASE_RECOVERY_INTERVAL=10000
OUTBOX_MAINTENANCE_CLEANUP_INTERVAL=600000
OUTBOX_MAINTENANCE_STATUS_LOG_INTERVAL=10000

### Inbox
# How long a claimed group stays with the node that claimed it; ms, from 1 to 2147483647. What the
# lease does is in docs/architecture/inbox.md, "The lease".
INBOX_LEASE_DURATION=600000
# How many attempts an update has, from 1; what counts is in docs/architecture/inbox.md, "Outcomes".
# The retry delay between them is the outbox's, the three OUTBOX_RETRY_ variables.
INBOX_MAX_ATTEMPTS=10
# How long a done and a skipped update are kept after their end before the cleanup deletes them;
# ms. The done one may not be kept less than a day, from 86400000 to 9007199254740991: Telegram
# redelivers an update within 24 h, and the stored row is what turns the redelivery away. The
# skipped one is from 1 to 9007199254740991. A failed update is never deleted automatically. The
# defaults are 7 and 30 days. What the cleanup does is in docs/architecture/inbox.md, "Cleanup".
INBOX_DONE_RETENTION=604800000
INBOX_SKIPPED_RETENTION=2592000000
# The most updates, or groups, one call of the cleanup deletes; from 1 to 9007199254740991.
INBOX_CLEANUP_BATCH_SIZE=1000

### Font convertor
# The FontForge binary. The image has fontforge-nox installed, so the name of the binary in PATH
# is enough.
FONT_FORGE_PATH=fontforge
# The directory of the temporary files of a conversion. Blank means <application root>/tmp, which
# inside the container is /app/tmp, where the app-tmp volume is mounted
# (docker-compose.app.yml). A value takes the files out of the volume, so it is only overridden
# for a mount point of one's own.
TEMP_DIR=
