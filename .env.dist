# Environment template. The stack is started with `docker compose up` (see README.md).
#
# This is a working set for local development, not a copy of the defaults of the code: some of
# the values exist only for the compose stack (the database port on the host, the database name
# and its accounts) and have no counterpart in the code. Everything else is kept equal to the
# default from ConfigContainer — otherwise the template silently starts dictating other
# behaviour. What the application reads and with which defaults is the table in
# docs/architecture/config.md.

# The mode of the application: production | development | testing.
# In production the logs are written by PinoLogger (JSON), in the other modes by ConsoleLogger.
# The variable was renamed: the former ENVIRONMENT is no longer read. Mind that NODE_ENV is also
# set in the image (Dockerfile), so a start that bypasses Compose takes its value from there.
NODE_ENV=development

### Postgres START ###
## Host settings
DATABASE_HOST=localhost
# The port Postgres is published on to the host. Inside the compose network the application
# always goes to pgsql:5432 — that is set in docker-compose.app.yml and overrides the values
# from here.
DATABASE_PORT=54320

## Superuser settings for Docker
# see https://github.com/docker-library/docs/tree/master/postgres#postgres_user
DATABASE_SUPERUSER_NAME=root
# see https://github.com/docker-library/docs/tree/master/postgres#postgres_password
DATABASE_SUPERUSER_PASSWORD=root

## Settings of the ordinary user and of the database
# The name of the database that will be created for the application
DATABASE_NAME=docker_db
# The name of the user that will be created for the application
DATABASE_USER_NAME=docker
# The password of the user the application will connect with
DATABASE_USER_PASSWORD=docker
# The time zone of the database
DATABASE_TIMEZONE=Asia/Tashkent
# The date style of the database
DATABASE_DATE_STYLE="iso, dmy"
# The maximum number of connections
DATABASE_CONNECTION_LIMIT=10
# The maximum idle time of a connection (in seconds)
DATABASE_CONNECTION_IDLE_TIMEOUT=10
# The maximum lifetime of a connection (in seconds). It is the upper bound of a life, so it has
# to be greater than the idle time: otherwise a connection never lives to the end of an idle
# period.
DATABASE_CONNECTION_MAX_LIFETIME=600

# DATABASE_URL is deliberately not here: it is read only by node-pg-migrate and is assembled in
# docker-compose.app.yml, where ${...} substitution really works (in an env_file Compose passes
# the values as they are, without expansion).
### Postgres END ###


### The hot configuration file
# The path of the file the application watches: on every edit of it the configuration is
# rebuilt, and the code subscribed to a path that changed receives the new value
# (docs/architecture/config.md, "Watching the file"). Blank means <application root>/.runtime.env,
# which inside the container is /app/.runtime.env, where the file of the same name from the host
# is mounted (docker-compose.app.yml). The values of the file yield to the environment variables,
# including the ones set here: what can be changed on the fly is what the environment does not
# hold or what is declared blank (a blank value does not count from either side). A missing file
# is a normal state, and the values are then taken from the environment alone.
CONFIG_FILE_PATH=
# How often that file is polled, ms; a value that is not allowed fails the start. Polling by the
# modification time rather than a subscription to file system events: inside the container the
# file lies on a bind mount, and events from the host do not always reach it.
CONFIG_FILE_WATCH_INTERVAL=2000


## Logger
# The minimum logging level; it and everything more serious is written. The allowed levels and
# the default, which depends on the mode, are in docs/architecture/logging.md.
#
# The variable was renamed: the former LOGGER_LEVELS with a list of levels is no longer read.
# Removed: the former LOGGER_DEFAULT is no longer read — the logging backend is chosen by
# NODE_ENV.
LOGGER_LEVEL=""

### Bot
# The token from @BotFather. Required — without it the application does not start.
BOT_TOKEN=


### Graceful shutdown
# The overall deadline for stopping the application as a whole: shutting the bot down, draining
# the outgoing queue, stopping the broker and closing the Postgres pool. Whatever did not make it
# stays unfinished and the process exits. It has to be greater than the sum of the bot and the
# scheduler deadlines below (they are spent one after another) — otherwise the application does
# not start and fails with InvalidConfigError. The check goes no further than that: the own
# deadlines of the dependencies (sql.end() when the pool is closed, say, has 5 seconds of its
# own) are not summed up here, so the value is taken with a margin. It has to be less than the
# stop grace period of the container (docker-compose.app.yml), otherwise the container is killed
# before the deadline.
# The variable was renamed: the former BOT_SHUTDOWN_TIMEOUT is no longer read — the deadline is
# now about stopping the whole application rather than the bot alone.
GRACEFUL_SHUTDOWN_TIMEOUT=15000
# How long to wait for the long-polling runner of the bot to stop.
BOT_GRACEFUL_SHUTDOWN_TIMEOUT=3000
# How long to wait for the outgoing TaskQueue to drain. 0 means not to wait at all.
TASK_QUEUE_GRACEFUL_SHUTDOWN_TIMEOUT=5000
# How often to check during that time whether the queue has drained. Greater than zero.
TASK_QUEUE_GRACEFUL_SHUTDOWN_INTERVAL=500


### Limits
# Common
LIMIT_COMMON_NUMBER=30
LIMIT_COMMON_INTERVAL=1000
# Private
LIMIT_PRIVATE_NUMBER=3
LIMIT_PRIVATE_INTERVAL=1000
# Group
LIMIT_GROUP_NUMBER=20
LIMIT_GROUP_INTERVAL=60000

### Task queue
# How often TaskQueue writes the number of tasks and partitions to the info log, and while a
# pause after a 429 is running how much of it is left, ms. A huge value does not switch the log
# off: a Node timer turns anything above its ceiling into 1 ms, and the log is then written
# continuously.
TASK_QUEUE_LOG_INTERVAL=10000

### runner
# The bounds of the sleep of the Runner loop when the queue is empty or the limits are taken, ms.
# The pause is picked at random between them on every such iteration: an even step lands in the
# same point of the cooldown window of the limits time after time. The minimum is greater than
# zero, the maximum is not below the minimum.
# The variable was renamed: the former RUNNER_SLEEP_INTERVAL with a single value is no longer
# read.
RUNNER_SLEEP_INTERVAL_MIN=10
RUNNER_SLEEP_INTERVAL_MAX=1000
# How many times a task goes back into the queue after an error from Telegram before it is
# dropped.
RUNNER_MAX_RETRIES=3

### Font convertor
# The image has fontforge-nox installed, so the name of the binary in PATH is enough.
FONT_FORGE_PATH=fontforge
# The directory of the temporary files of a conversion. Blank means <application root>/tmp, which
# inside the container is /app/tmp, where the app-tmp volume is mounted
# (docker-compose.app.yml). A value takes the files out of the volume, so it is only overridden
# for a mount point of one's own.
TEMP_DIR=
