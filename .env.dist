# Шаблон окружения. Запуск — через `docker compose up` (см. README.md).

# Режим работы приложения: production | development | testing.
# В production логи пишет PinoLogger (JSON), в остальных режимах — ConsoleLogger.
# Переменная переименована: прежняя ENVIRONMENT больше не читается. Учтите, что NODE_ENV
# задан и в образе (Dockerfile), поэтому при запуске мимо Compose значение придёт оттуда.
NODE_ENV=development

### Postgres START ###
## Настройки хоста
DATABASE_HOST=localhost
# Порт, на который Postgres пробрасывается на хост. Внутри compose-сети приложение всегда
# ходит на pgsql:5432 — это задано в docker-compose.yml и переопределяет значения отсюда.
DATABASE_PORT=54320

## Настройки суперюзера для докера
# see https://github.com/docker-library/docs/tree/master/postgres#postgres_user
DATABASE_SUPERUSER_NAME=root
# see https://github.com/docker-library/docs/tree/master/postgres#postgres_password
DATABASE_SUPERUSER_PASSWORD=root

## Настройки обычного пользователя и БД
# Названия БД который будет создан для использования приложением
DATABASE_NAME=docker_db
# Имя пользователя который будет создан для использования приложения
DATABASE_USER_NAME=docker
# Пароль пользователя который будет использоваться приложением
DATABASE_USER_PASSWORD=docker
# Таймзона БД
DATABASE_TIMEZONE=Asia/Tashkent
# Настройка дат в БД
DATABASE_DATE_STYLE="iso, dmy"
# Максимальное количество подключений
DATABASE_CONNECTION_LIMIT=100
# Максимальное время простоя подключение(в секундах)
DATABASE_CONNECTION_IDLE_TIMEOUT=60
# Максимальное время работы подключения (в секундах)
DATABASE_CONNECTION_MAX_LIFETIME=10

# DATABASE_URL здесь намеренно нет: её читает только node-pg-migrate, и собирается она
# в docker-compose.yml, где подстановка ${...} действительно работает (в env_file Compose
# значения передаются как есть, без раскрытия).
### Postgres END ###


## Logger
# Минимальный уровень логирования. Можно указать: debug, info, warning, error, critical
# Пишется указанный уровень и всё, что серьёзнее:
#  - debug - пишется всё
#  - info - info, warning, error, critical
#  - error - только error и critical
#
# Если ничего не указать - значение будет зависеть от PRODUCTION mode
#  - isProduction - warning
#  - isNotProduction - debug
#
# Переменная переименована: прежняя LOGGER_LEVELS с перечислением уровней больше не читается.
# Удалена: прежняя LOGGER_DEFAULT больше не читается — бэкенд логирования выбирает NODE_ENV.
LOGGER_LEVEL=""

### Bot
# Токен от @BotFather. Обязателен — без него приложение не стартует.
BOT_TOKEN=


### Graceful shutdown
# Сколько миллисекунд отведено ожиданию при остановке: гашение бота и разгрузка исходящей
# очереди. Что не успело — остаётся незавершённым; брокер останавливается и пул Postgres
# закрывается в любом случае. Значение должно быть меньше stop grace period контейнера
# (у Compose это 10 секунд по умолчанию), иначе до таймаута дело не дойдёт — контейнер убьют
# раньше. 0 — не ждать вовсе.
# Переменная переименована: прежняя BOT_SHUTDOWN_TIMEOUT больше не читается — срок теперь
# про остановку всего приложения, а не только бота.
GRACEFUL_SHUTDOWN_TIMEOUT=5000
# Как часто в это время проверять, разгрузилась ли очередь Planner.
PLANNER_GRACEFUL_SHUTDOWN_INTERVAL=3000


### Limits
# Common
LIMIT_COMMON_NUMBER=30
LIMIT_COMMON_INTERVAL=1000
# Private
LIMIT_PRIVATE_NUMBER=3
LIMIT_PRIVATE_INTERVAL=1000
# Group
LIMIT_GROUP_NUMBER=20
LIMIT_GROUP_INTERVAL=60000

### broker
BROKER_SLEEP_INTERVAL=10
# Сколько раз сообщение возвращается в очередь после ошибки Telegram, прежде чем будет отброшено.
BROKER_MAX_RETRIES=3

### Font covertor
# В образе установлен fontforge-nox, поэтому достаточно имени бинарника в PATH.
FONT_FORGE_PATH=fontforge
