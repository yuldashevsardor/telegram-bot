# Хук ставит package.json#prepare при `npm install` на хосте, поэтому он есть только у
# хостовой разработки. Node может быть не виден и там, где он установлен: hook-окружение
# git минимально, и nvm в нём не инициализирован. Падать в таком случае нельзя — коммит
# заблокировался бы у того, кто про хук даже не знает.
if ! command -v npx > /dev/null 2>&1; then
    printf 'pre-commit: node на хосте недоступен, lint-staged пропущен — проверки за make check\n' >&2
    exit 0
fi

npx lint-staged
