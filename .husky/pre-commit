# Where node is not visible from git's hook environment (README.md, "The pre-commit hook"), the
# hook must not fail: it would block the commit of someone who does not even know about the hook.
if ! command -v npx > /dev/null 2>&1; then
    printf 'pre-commit: node is not available on the host, lint-staged skipped — the checks are up to make check\n' >&2
    exit 0
fi

npx lint-staged
