{
    // transpile-only вынужденно: mocha грузит spec-файлы через import(), а ts-node 10
    // на этом пути отдаёт компилятору не тот исходник и под strict сыплет ложными
    // TS7006 на явно типизированные параметры. Типы тестов проверяет npm run typecheck.
    "require": ["ts-node/register/transpile-only", "tsconfig-paths/register"],
    "spec": "test/**/*.spec.ts",
    "color": true
}
