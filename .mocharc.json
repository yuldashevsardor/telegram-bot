{
    // tsx loads TypeScript, with its tsconfig from TSX_TSCONFIG_PATH in the test npm script; why,
    // and what tsx does and does not do — the list at the top of docs/architecture/testing.md.
    // database-hook goes after tsx because it is written in TypeScript itself; it creates a
    // database per run (same file, "The test database"). Stryker (stryker.config.mjs) takes spec
    // from here, while require it sets on its own — without database-hook: a new require is
    // needed there too.
    "require": ["tsx/cjs", "./test/database-hook.ts"],
    "spec": "test/**/*.spec.ts",
    "color": true
}
