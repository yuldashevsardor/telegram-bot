{
    "name": "telegram-bot",
    "version": "1.0.0",
    "description": "Telegram bot starter kit",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=24.20.0 <25"
    },
    "main": "./build/src/index.js",
    "scripts": {
        "build": "del-cli -rf build && tsc && tsc-alias",
        "start": "node build/app.js",
        "start:prod": "NODE_ENV=production node build/app.js",
        "prepare": "husky install && chmod +x .husky/pre-commit",
        "test": "mocha --colors --require ts-node/register --file  test/bootstrap.ts test/**/*.spec.ts",
        "migrate": "node node_modules/.bin/node-pg-migrate -f ./migrate.json"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --cache --fix",
            "prettier --write"
        ]
    },
    "nyc": {
        "extends": "@istanbuljs/nyc-config-typescript",
        "extension": [
            ".ts"
        ],
        "exclude": [
            "**/*.d.ts",
            "**/test/**/*",
            "**/*.js",
            "**/config.ts",
            "./coverage"
        ],
        "excludeNodeModules": true,
        "reporter": [
            "text",
            "lcov"
        ],
        "all": true
    },
    "dependencies": {
        "@grammyjs/conversations": "^1.2.0",
        "@grammyjs/fluent": "^1.0.3",
        "@grammyjs/runner": "^1.0.4",
        "@moebius/fluent": "^1.1.0",
        "dayjs": "^1.11.23",
        "dotenv": "^6.2.0",
        "dotenv-expand": "^8.0.3",
        "grammy": "^1.46.0",
        "inversify": "^6.2.2",
        "mime-types": "^2.1.35",
        "node-pg-migrate": "^6.2.2",
        "pg": "^8.23.0",
        "pino": "^8.21.0",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "serialize-error": "^8.1.0",
        "tiny-glob": "^0.2.9",
        "tslib": "^2.8.1",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@types/chai": "^4.3.20",
        "@types/dotenv": "^8.2.3",
        "@types/mime-types": "^2.1.4",
        "@types/mocha": "^9.1.1",
        "@types/node": "^17.0.45",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "chai": "^4.5.0",
        "del-cli": "^4.0.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^4.2.5",
        "husky": "^7.0.4",
        "lint-staged": "^12.5.0",
        "mocha": "^9.2.2",
        "nyc": "^15.1.0",
        "prettier": "^2.8.8",
        "prettier-eslint": "^13.0.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.3",
        "typescript": "^4.9.5"
    }
}
