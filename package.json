{
    "name": "telegram-bot",
    "version": "1.0.0",
    "private": true,
    "description": "Telegram-бот для конвертации файлов шрифтов между форматами (ttf, otf, woff, woff2, eot, svg)",
    "keywords": [
        "telegram",
        "bot",
        "grammy",
        "font",
        "font-converter",
        "fontforge",
        "ttf",
        "otf",
        "woff",
        "woff2",
        "eot",
        "svg"
    ],
    "homepage": "https://github.com/yuldashevsardor/telegram-bot#readme",
    "bugs": {
        "url": "https://github.com/yuldashevsardor/telegram-bot/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yuldashevsardor/telegram-bot.git"
    },
    "author": "Yuldashev Sardor <yuldashev.sardor1028@gmail.com>",
    "license": "MIT",
    "type": "commonjs",
    "engines": {
        "node": ">=24.20.0 <25"
    },
    "main": "./build/app.js",
    "scripts": {
        "build": "del-cli -rf build && tsc && tsc-alias && cpy \"src/**/*.ftl\" build",
        "typecheck": "tsc -p tsconfig.check.json",
        "start": "node build/app.js",
        "dev": "TSX_TSCONFIG_PATH=./tsconfig.check.json node --watch --require tsx/cjs src/app.ts",
        "start:prod": "NODE_ENV=production node build/app.js",
        "prepare": "husky",
        "lint": "eslint src test migrations",
        "lint:fix": "eslint --fix src test migrations",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.ts\"",
        "test": "TSX_TSCONFIG_PATH=./tsconfig.check.json mocha",
        "test:watch": "TSX_TSCONFIG_PATH=./tsconfig.check.json mocha --watch",
        "test:coverage": "TSX_TSCONFIG_PATH=./tsconfig.check.json nyc mocha --require tsx/cjs --require ./test/coverage-hook.ts",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
        "mutation": "TSX_TSCONFIG_PATH=./tsconfig.check.json NODE_OPTIONS=--require=./test/stryker-mocha-hook.cjs stryker run",
        "migrate": "node-pg-migrate -f ./migrate.json"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --cache --fix",
            "prettier --write"
        ]
    },
    "nyc": {
        "cache": false,
        "extension": [
            ".ts"
        ],
        "include": [
            "src/**/*.ts"
        ],
        "exclude": [
            "src/app.ts"
        ],
        "parserPlugins": [
            "asyncGenerators",
            "bigInt",
            "classProperties",
            "classPrivateProperties",
            "classPrivateMethods",
            "dynamicImport",
            "importMeta",
            "numericSeparator",
            "objectRestSpread",
            "optionalCatchBinding",
            "topLevelAwait",
            "typescript",
            "decorators-legacy"
        ],
        "hookRequire": false,
        "exitOnError": true,
        "skipEmpty": true,
        "reporter": [
            "text",
            "lcov"
        ],
        "all": true,
        "check-coverage": true,
        "lines": 99,
        "branches": 99,
        "functions": 99,
        "statements": 99
    },
    "dependencies": {
        "@grammyjs/conversations": "^1.2.0",
        "@grammyjs/runner": "^2.0.3",
        "@moebius/fluent": "^1.1.0",
        "dayjs": "^1.11.23",
        "dotenv": "^17.4.2",
        "grammy": "^1.46.0",
        "inversify": "^6.2.2",
        "node-pg-migrate": "^9.0.0",
        "pg": "^8.23.0",
        "pino": "^8.21.0",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "serialize-error": "^13.0.1",
        "tslib": "^2.8.1",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@stryker-mutator/core": "^10.0.0",
        "@stryker-mutator/mocha-runner": "^10.0.0",
        "@types/chai": "^4.3.20",
        "@types/istanbul-lib-instrument": "^1.7.8",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.13.4",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "chai": "^4.5.0",
        "cpy-cli": "^7.0.0",
        "del-cli": "^4.0.1",
        "esbuild": "^0.28.2",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^4.2.5",
        "husky": "^9.1.7",
        "istanbul-lib-instrument": "^6.0.3",
        "lint-staged": "^12.5.0",
        "mocha": "^12.0.0",
        "nyc": "^18.0.0",
        "prettier": "^2.8.8",
        "prettier-eslint": "^13.0.0",
        "tsc-alias": "^1.9.3",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3"
    }
}
