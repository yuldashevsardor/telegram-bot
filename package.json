{
    "name": "telegram-bot",
    "version": "1.0.0",
    "private": true,
    "description": "Telegram-бот для конвертации файлов шрифтов между форматами (ttf, otf, woff, woff2, eot, svg)",
    "keywords": [
        "telegram",
        "bot",
        "grammy",
        "font",
        "font-converter",
        "fontforge",
        "ttf",
        "otf",
        "woff",
        "woff2",
        "eot",
        "svg"
    ],
    "homepage": "https://github.com/yuldashevsardor/telegram-bot#readme",
    "bugs": {
        "url": "https://github.com/yuldashevsardor/telegram-bot/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yuldashevsardor/telegram-bot.git"
    },
    "author": "Yuldashev Sardor <yuldashev.sardor1028@gmail.com>",
    "license": "MIT",
    "type": "commonjs",
    "engines": {
        "node": ">=24.20.0 <25"
    },
    "main": "./build/app.js",
    "scripts": {
        "build": "del-cli -rf build && tsc && tsc-alias",
        "typecheck": "tsc -p tsconfig.check.json",
        "start": "node build/app.js",
        "dev": "node --watch --require ts-node/register --require tsconfig-paths/register src/app.ts",
        "start:prod": "NODE_ENV=production node build/app.js",
        "prepare": "husky install && chmod +x .husky/pre-commit",
        "lint": "eslint src test",
        "lint:fix": "eslint --fix src test",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "mocha",
        "test:watch": "mocha --watch",
        "test:coverage": "nyc mocha",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
        "migrate": "node -r tsconfig-paths/register node_modules/.bin/node-pg-migrate -f ./migrate.json"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --cache --fix",
            "prettier --write"
        ]
    },
    "nyc": {
        "extends": "@istanbuljs/nyc-config-typescript",
        "extension": [
            ".ts"
        ],
        "exclude": [
            "**/*.d.ts",
            "**/test/**/*",
            "**/*.js",
            "**/config.ts",
            "./coverage"
        ],
        "excludeNodeModules": true,
        "reporter": [
            "text",
            "lcov"
        ],
        "all": true
    },
    "dependencies": {
        "@grammyjs/conversations": "^1.2.0",
        "@grammyjs/fluent": "^1.0.3",
        "@grammyjs/runner": "^1.0.4",
        "@moebius/fluent": "^1.1.0",
        "dayjs": "^1.11.23",
        "dotenv": "^6.2.0",
        "dotenv-expand": "^8.0.3",
        "grammy": "^1.46.0",
        "inversify": "^6.2.2",
        "mime-types": "^3.0.2",
        "node-pg-migrate": "^6.2.2",
        "pg": "^8.23.0",
        "pino": "^8.21.0",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "serialize-error": "^8.1.0",
        "tiny-glob": "^0.2.9",
        "tslib": "^2.8.1",
        "uuid": "^14.0.2"
    },
    "devDependencies": {
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@types/chai": "^4.3.20",
        "@types/dotenv": "^6.1.1",
        "@types/mime-types": "^3.0.1",
        "@types/mocha": "^9.1.1",
        "@types/node": "^17.0.45",
        "@typescript-eslint/eslint-plugin": "^8.69.0",
        "@typescript-eslint/parser": "^8.69.0",
        "chai": "^4.5.0",
        "del-cli": "^4.0.1",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^8.10.2",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^4.2.5",
        "husky": "^7.0.4",
        "lint-staged": "^12.5.0",
        "mocha": "^9.2.2",
        "nyc": "^15.1.0",
        "prettier": "^2.8.8",
        "prettier-eslint": "^13.0.0",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.3",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^6.0.3"
    }
}
