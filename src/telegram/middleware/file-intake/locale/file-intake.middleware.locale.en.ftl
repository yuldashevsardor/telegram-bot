# maxDownloadSizeMb (number): The largest file size in MB
file-intake-middleware-too-large = The file is over {$maxDownloadSizeMb} MB: Telegram does not let bots download such files.

# filename (string): The name of the file sent
# formats (string): Font formats
file-intake-middleware-unsupported = "{$filename}" is not a font, or not a format I know. I support: {$formats}.

# formats (string): Font formats
file-intake-middleware-unsupported-unnamed = The file is not a font, or not a format I know. I support: {$formats}.

# format (string): The format the extension names
file-intake-middleware-not-in-format = The file is named as {$format}, but it is not {$format} inside. Perhaps its extension is wrong.

# format (string): The format the extension names
file-intake-middleware-broken = The file looks like {$format}, but it is damaged. Try downloading the font again from its source.

# format (string): The format of the font sent
file-intake-middleware-question = This is {$format}. What should I convert it into?
