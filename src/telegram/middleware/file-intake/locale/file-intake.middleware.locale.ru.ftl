# maxDownloadSizeMb (number): Наибольший размер файла в МБ
file-intake-middleware-too-large = Файл больше {$maxDownloadSizeMb} МБ — Telegram не даёт ботам скачивать такие файлы.

file-intake-middleware-too-large-for-telegram = Файл слишком большой — Telegram не даёт ботам скачивать такие файлы.

# filename (string): Имя присланного файла
# formats (string): Форматы шрифтов
file-intake-middleware-unsupported = «{$filename}» — не шрифт или формат, который я не знаю. Поддерживаю: {$formats}.

# formats (string): Форматы шрифтов
file-intake-middleware-unsupported-unnamed = Файл — не шрифт или формат, который я не знаю. Поддерживаю: {$formats}.

# format (string): Формат, который называет расширение
file-intake-middleware-not-in-format = Файл назван как {$format}, но внутри не {$format}. Возможно, у него не то расширение.

# format (string): Формат, который называет расширение
file-intake-middleware-broken = Файл похож на {$format}, но повреждён. Попробуйте скачать шрифт заново из источника.

# format (string): Формат присланного шрифта
file-intake-middleware-question = Это {$format}. Во что сконвертировать?
