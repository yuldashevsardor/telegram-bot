{
    // Проверка типов по всему репозиторию: сборочный tsconfig.json ограничен src,
    // потому что из него эмитится build, а тесты, spec-файлы и миграции тоже должны
    // проверяться. Эмита здесь нет, поэтому rootDir можно расширить до корня.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "declarationDir": null,
        "declaration": false,
        "declarationMap": false,
        "rootDir": "."
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js",
        "test/**/*.ts",
        "migrations/**/*.ts"
    ],
    // Единственное исключение — заготовка миграции: её импорт ./common/utils рассчитан
    // на каталог, куда её скопирует migrate-create, и с её собственного места не
    // резолвится. node_modules и coverage перечислять незачем: include выше их не
    // захватывает.
    "exclude": [
        "migrations/common/template.ts"
    ]
}
