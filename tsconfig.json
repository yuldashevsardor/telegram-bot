{
    "compilerOptions": {
        "declaration": true,
        "target": "ES2024",
        "module": "node20",
        "rootDir": "./src",
        "declarationDir": "./typings",
        "experimentalDecorators": true,
        // Off on purpose: nobody reads the emitted parameter metadata — every dependency is
        // injected by an explicit @inject (an invariant), and inference from the types is out of
        // reach anyway, because esbuild does not emit them in dev. With the flag on, dev and the
        // build would be left with different metadata, and that would decide whether inversify
        // counts a parameter with a default value (configValue) as a dependency of its own.
        "emitDecoratorMetadata": false,
        // Decorators stop working with this on; why has not been established
        "useDefineForClassFields": false,
        "importHelpers": true,
        "esModuleInterop": true,
        "declarationMap": true,
        //        "inlineSourceMap": true,
        // Left on out of necessity: without skipping the check of .d.ts files tsc fails on the
        // declarations of dependencies that import untyped modules (TS7016): the build on
        // node-fetch inside grammy, the typecheck by tsconfig.check.json on pg inside
        // node-pg-migrate as well.
        "skipLibCheck": true,
        "strict": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true,
        "lib": [
            "ESNext",
            "ES6",
            "DOM"
        ],
        "types": [
            "node",
            "mocha",
            "chai",
            "reflect-metadata"
        ],
        "outDir": "./build",
        "paths": {
            "app/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "coverage"
    ]
}
