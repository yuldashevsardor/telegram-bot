{
    "compilerOptions": {
        "declaration": true,
        "target": "ES2024",
        "module": "node20",
        "rootDir": "./src",
        "declarationDir": "./typings",
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        // Почему-то с этим не работает декораторы
        "useDefineForClassFields": false,
        "importHelpers": true,
        "esModuleInterop": true,
        "declarationMap": true,
        //        "inlineSourceMap": true,
        // Оставлены включёнными вынужденно: @types/node зафиксированы на 17.x, и без
        // пропуска проверки .d.ts сборка падает на несовместимости их Buffer с lib
        // ESNext, а также на untyped node-fetch внутри grammy. Снимать вместе с
        // обновлением @types/node.
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strict": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true,
        "lib": [
            "ESNext",
            "ES6",
            "DOM"
        ],
        "types": [
            "node",
            "mocha",
            "chai",
            "reflect-metadata"
        ],
        "outDir": "./build",
        // baseUrl объявлен устаревшим в TS 6 и удалён в TS 7, но tsconfig-paths
        // без него не резолвит app/* в рантайме (dev, mocha, migrate).
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "paths": {
            "app/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "coverage",
        // Не код, а заготовка, из которой node-pg-migrate делает файл миграции:
        // pgm там объявлен, но ещё не используется, а импорт utils разрешается
        // только после копирования в каталог миграций.
        "src/infrastructure/database/migrations/common/template.ts"
    ]
}
