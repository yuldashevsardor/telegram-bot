{
    "compilerOptions": {
        "declaration": true,
        "target": "ES2024",
        "module": "node20",
        "rootDir": "./src",
        "declarationDir": "./typings",
        "experimentalDecorators": true,
        // Выключено намеренно: эмитированные метаданные параметров никто не читает — все
        // зависимости внедряются явным @inject (инвариант), а вывод по типам всё равно
        // недоступен, потому что esbuild в dev их не эмитит. Включённый флаг оставлял бы dev
        // и сборку с разными метаданными, и от этого зависело бы, считает ли inversify своей
        // зависимостью параметр со значением по умолчанию (configValue).
        "emitDecoratorMetadata": false,
        // Почему-то с этим не работает декораторы
        "useDefineForClassFields": false,
        "importHelpers": true,
        "esModuleInterop": true,
        "declarationMap": true,
        //        "inlineSourceMap": true,
        // Оставлены включёнными вынужденно: @types/node зафиксированы на 17.x, и без
        // пропуска проверки .d.ts сборка падает на несовместимости их Buffer с lib
        // ESNext, а также на untyped node-fetch внутри grammy. Снимать вместе с
        // обновлением @types/node.
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "strict": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "sourceMap": true,
        "lib": [
            "ESNext",
            "ES6",
            "DOM"
        ],
        "types": [
            "node",
            "mocha",
            "chai",
            "reflect-metadata"
        ],
        "outDir": "./build",
        "paths": {
            "app/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "coverage"
    ]
}
